cabal-version:      2.4
name:               unfold-instrument
version:            0.1.0.0
synopsis:           Rewrites Haskell programs for Unfold tracing
build-type:         Simple

executable unfold-instrument
  main-is:          Main.hs
  hs-source-dirs:   app, src
  other-modules:    Unfold.Fixity
  build-depends:    base, ghc, ghc-boot, containers, process
  default-language: Haskell2010
  ghc-options:      -O1 -Wall
